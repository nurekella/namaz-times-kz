<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NamazTimes</AssemblyName>
    <Product>Namaz Times KZ</Product>
    <AssemblyTitle>Namaz Times KZ</AssemblyTitle>
    <Version>0.3.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- No designer in this project; controls are built in code. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="cities.json" LogicalName="cities.json" />
    <!-- CI passes -p:GitHubRepo=owner/name so the app can check Releases for updates. -->
    <AssemblyMetadata Include="GitHubRepo" Value="$(GitHubRepo)" Condition="'$(GitHubRepo)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="installer/**" />
  </ItemGroup>

</Project>
